barrier a, b;
ccx a[5], b[4], b[5];
cx b[5], a[5];
cx a[5], b[4];
barrier a, b;
ccx a[4], b[3], b[4];
cx b[4], a[4];
cx a[4], b[3];
barrier a, b;
ccx a[3], b[2], b[3];
cx b[3], a[3];
cx a[3], b[2];
barrier a, b;
ccx a[2], b[1], b[2];
cx b[2], a[2];
cx a[2], b[1];
barrier a, b;
ccx a[1], b[0], b[1];
cx b[1], a[1];
cx a[1], b[0];
barrier a, b;
ccx a[0], cin, b[0];
cx b[0], a[0];
cx a[0], cin;
barrier a, b, cin, cout;

sum_out[0] = measure b[0];
sum_out[1] = measure b[1];
sum_out[2] = measure b[2];
sum_out[3] = measure b[3];
