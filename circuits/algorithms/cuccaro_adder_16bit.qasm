OPENQASM 3.0;
include "stdgates.inc";

// Cuccaro Quantum Ripple-Carry Adder (16-bit Registers)

qubit[16] a;
qubit[16] b;
qubit cin;
qubit cout;
bit[16] sum_out;
bit cout_bit;

// Majority (MAJ) carry gates
cx b[0], a[0];
cx b[0], cin;
ccx a[0], cin, b[0];
barrier a, b, cin;

cx b[1], a[1];
cx b[1], b[0];
ccx a[1], b[0], b[1];
barrier a, b;
cx b[2], a[2];
cx b[2], b[1];
ccx a[2], b[1], b[2];
barrier a, b;
cx b[3], a[3];
cx b[3], b[2];
ccx a[3], b[2], b[3];
barrier a, b;
cx b[4], a[4];
cx b[4], b[3];
ccx a[4], b[3], b[4];
barrier a, b;
cx b[5], a[5];
cx b[5], b[4];
ccx a[5], b[4], b[5];
barrier a, b;
cx b[6], a[6];
cx b[6], b[5];
ccx a[6], b[5], b[6];
barrier a, b;
cx b[7], a[7];
cx b[7], b[6];
ccx a[7], b[6], b[7];
barrier a, b;
cx b[8], a[8];
cx b[8], b[7];
ccx a[8], b[7], b[8];
barrier a, b;
cx b[9], a[9];
cx b[9], b[8];
ccx a[9], b[8], b[9];
barrier a, b;
cx b[10], a[10];
cx b[10], b[9];
ccx a[10], b[9], b[10];
barrier a, b;
cx b[11], a[11];
cx b[11], b[10];
ccx a[11], b[10], b[11];
barrier a, b;
cx b[12], a[12];
cx b[12], b[11];
ccx a[12], b[11], b[12];
barrier a, b;
cx b[13], a[13];
cx b[13], b[12];
ccx a[13], b[12], b[13];
barrier a, b;
cx b[14], a[14];
cx b[14], b[13];
ccx a[14], b[13], b[14];
barrier a, b;
cx b[15], a[15];
cx b[15], b[14];
ccx a[15], b[14], b[15];
barrier a, b;

cx b[15], cout;

// Unmajority and Add (UMA) gates
ccx a[15], b[14], b[15];
cx b[15], a[15];
cx a[15], b[14];
barrier a, b;
ccx a[14], b[13], b[14];
cx b[14], a[14];
cx a[14], b[13];
barrier a, b;
ccx a[13], b[12], b[13];
cx b[13], a[13];
cx a[13], b[12];
barrier a, b;
ccx a[12], b[11], b[12];
cx b[12], a[12];
cx a[12], b[11];
barrier a, b;
ccx a[11], b[10], b[11];
cx b[11], a[11];
cx a[11], b[10];
barrier a, b;
ccx a[10], b[9], b[10];
cx b[10], a[10];
cx a[10], b[9];
barrier a, b;
ccx a[9], b[8], b[9];
cx b[9], a[9];
cx a[9], b[8];
barrier a, b;
ccx a[8], b[7], b[8];
cx b[8], a[8];
cx a[8], b[7];
barrier a, b;
ccx a[7], b[6], b[7];
cx b[7], a[7];
cx a[7], b[6];
